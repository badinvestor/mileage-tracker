# Copy this file to .env and fill in your key, or export these in your shell.

# Required: your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which model to use. Defaults to claude-opus-4-8.
#   claude-opus-4-8  - excellent tool use, no special setup (default)
#   claude-fable-5   - most capable; requires 30-day data retention on your org
#   claude-haiku-4-5 - cheapest and fastest
ASSISTANT_MODEL=claude-opus-4-8
